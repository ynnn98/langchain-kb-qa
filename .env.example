# ===== SmartKB 配置文件 =====
# 使用方法：复制本文件为 .env（Windows: copy .env.example .env），然后填入自己的 Key

# ---------- 对话大模型（LLM） ----------
# openai_compatible = 任意兼容 OpenAI 协议的在线服务；ollama = 本地离线大模型
LLM_PROVIDER=openai_compatible

# 方式一（默认示例）：智谱 BigModel —— glm-4-flash 免费，且同时提供 Embedding，一个 Key 即可跑通全部功能
# 申请地址: https://open.bigmodel.cn  （注册后在"API Keys"页面创建）
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=在此填入你的智谱APIKey
LLM_MODEL=glm-4-flash

# 方式二：DeepSeek（仅提供对话模型，Embedding 需另配，见下方 EMBEDDING 段）
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat

# 方式三：通义千问（百炼兼容模式）
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 方式四：Kimi（月之暗面）
# LLM_API_BASE=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# 方式五：OpenAI 官方
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 方式六：本地离线大模型（需先安装 Ollama: https://ollama.com 并执行 ollama pull qwen2.5:7b）
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# 生成随机性，0 = 更严谨
TEMPERATURE=0.2

# ---------- 向量化模型（Embedding） ----------
# openai_compatible = 在线接口（默认复用上面的 LLM_API_KEY 和地址）；huggingface = 本地离线模型
EMBEDDING_PROVIDER=openai_compatible
# 智谱 embedding-3；若换用其他厂商，改成对应模型名，例如 SiliconFlow: BAAI/bge-m3
EMBEDDING_MODEL=embedding-3
# 如 Embedding 与 LLM 不在同一平台，取消注释并单独填写：
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxx

# 完全离线方案（需先: pip install -r requirements-offline.txt）：
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 知识库参数 ----------
CHROMA_DIR=./chroma_db
COLLECTION_NAME=smartkb
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
